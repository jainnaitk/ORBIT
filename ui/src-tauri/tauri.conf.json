{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetroLite",
  "version": "0.1.0",
  "identifier": "com.metrolite.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MetroLite",
        "width": 1060,
        "height": 680,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
